{
  "colors": {
    "primary": "#1A365D",
    "secondary": "#2C5282",
    "accent": "#C05621",
    "text": "#2D3748",
    "lightGray": "#718096",
    "border": "#E2E8F0",
    "headerBg": "#EDF2F7"
  },
  "fonts": {
    "primary": "InterVariable, 'Noto Sans SC', sans-serif",
